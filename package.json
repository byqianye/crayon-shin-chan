{
  "name": "crayon-shin-chan",
  "version": "0.1.8",
  "description": "蜡笔小新 - Windows 影视聚合客户端",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "byqianye",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/byqianye/crayon-shin-chan.git"
  },
  "private": true,
  "scripts": {
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File native-rust/scripts/build.ps1 -Run",
    "dev:electron": "electron-vite dev",
    "build:rust": "pwsh -NoProfile -ExecutionPolicy Bypass -File native-rust/scripts/build.ps1 -Profile release",
    "package:rust": "pwsh -NoProfile -ExecutionPolicy Bypass -File native-rust/scripts/package.ps1",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222",
    "selftest": "node scripts/selftest.mjs",
    "icon:build": "node scripts/make-icon.mjs",
    "icon:check": "node scripts/make-icon.mjs --check",
    "spider:deps": "powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/fetch-deps.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/fetch-unidbg.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/fetch-tools.ps1",
    "spider:build": "powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/build.ps1",
    "spider:unidbg": "powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/build-unidbg.ps1",
    "spider:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File spider-host/build-runtime.ps1",
    "spider:smoke": "node scripts/spider-service-smoke.mjs",
    "spider:contract": "node scripts/spider-contract.mjs",
    "spider:matrix": "node scripts/spider-matrix.mjs --cases spider-tests/cases.json",
    "release:check": "node scripts/release-check.mjs --rust",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "ci:check": "node scripts/check-ci.mjs",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "node scripts/ensure-electron.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File native-rust/scripts/package.ps1",
    "build:win:electron": "electron-vite build && electron-builder --win --publish never",
    "build:win:lite": "electron-vite build && electron-builder --win --config electron-builder.lite.yml --publish never"
  },
  "dependencies": {
    "artplayer": "^5.4.0",
    "cheerio": "^1.2.0",
    "domhandler": "5.0.3",
    "hls.js": "^1.7.3",
    "iconv-lite": "^0.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
